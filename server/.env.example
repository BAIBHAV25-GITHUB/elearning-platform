PORT=5000
NODE_ENV=development

# Database (used by the server and by scripts/seed-content.mjs)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elearning_db

# Auth - the server refuses to start without a real secret.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Integration (the webhook is rejected unless RAZORPAY_WEBHOOK_SECRET is set)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# CORS: comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Database TLS. Production defaults to a VERIFIED TLS connection to the database.
# DB_SSL=false                      # database on a private network without TLS (e.g. the docker-compose db container)
# DB_SSL_REJECT_UNAUTHORIZED=false  # provider with a self-signed certificate (weakens verification, use knowingly)

# Logging: debug | info | warn | error | silent (tests run silent). Production logs are one JSON object per line.
# LOG_LEVEL=info
# LOG_FORMAT=json                   # force JSON lines outside production

# General per-IP limit for every /api route, requests per minute (default 600)
# API_RATE_LIMIT=600

# Demo data. Used by `node scripts/db.mjs init` (the Docker entrypoint): the schema is created on an EMPTY database
# and demo users / courses are added only when SEED_DEMO_DATA=true. The seed users share a KNOWN password, so
# the runner refuses to seed with NODE_ENV=production unless you also set ALLOW_SEED_IN_PRODUCTION=1.
# SEED_DEMO_DATA=false
# ALLOW_SEED_IN_PRODUCTION=0

# Optional
# Video processing (long videos are compressed and cut into pieces for the free Cloudinary plan)
# MAX_VIDEO_UPLOAD_MB=4096   # biggest original file an instructor may upload
# VIDEO_PART_SECONDS=600     # length of each piece
# VIDEO_MAX_HEIGHT=480       # pieces are scaled down to this height (never up)
# VIDEO_CRF=30               # quality: lower = better + bigger (23 good, 30 small)
# VIDEO_MAX_PART_MB=95       # fail if a piece is bigger than this (Cloudinary free limit is 100)
# TRUST_PROXY=1              # set when running behind one reverse proxy
# AUTH_RATE_LIMIT=20         # login/register attempts per IP per 15 min
# PENDING_ENROLLMENT_MINUTES=30

# Protected media (new uploads are served through signed URLs). Optional: with a Cloudinary
# token-based-authentication key the signed URLs also expire after MEDIA_URL_TTL_SECONDS.
# CLOUDINARY_AUTH_TOKEN_KEY=
# MEDIA_URL_TTL_SECONDS=3600
