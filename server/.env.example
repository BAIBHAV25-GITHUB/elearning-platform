PORT=5000
NODE_ENV=development

# Database (used by the server and by seed-content.mjs)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elearning_db

# Auth - the server refuses to start without a real secret.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Integration (the webhook is rejected unless RAZORPAY_WEBHOOK_SECRET is set)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# CORS: comma separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Optional
# TRUST_PROXY=1              # set when running behind one reverse proxy
# AUTH_RATE_LIMIT=20         # login/register attempts per IP per 15 min
# PENDING_ENROLLMENT_MINUTES=30
